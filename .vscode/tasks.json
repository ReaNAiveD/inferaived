{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "run inferaived (debug log)",
            "type": "cargo",
            "command": "run",
            "args": [
                "--package",
                "inferaived",
                "--example",
                "generate"
            ],
            "env": {
                "RUST_LOG": "debug"
            },
            "group": "build",
            "problemMatcher": ["$rustc"],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
